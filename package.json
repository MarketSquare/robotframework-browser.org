{
  "name": "robotframework-browser-org",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "nuxt dev",
    "build": "pnpm libdoc && nuxt build",
    "generate": "pnpm libdoc && nuxt generate && pnpm sitemap",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "pnpm content:clean && pnpm generate && pnpm test && pnpm check:bundle",
    "content:clean": "node -e \"require('node:fs').rmSync('.data', {recursive: true, force: true})\"",
    "refresh": "pnpm versions && pnpm releases && pnpm contributors && pnpm project && pnpm devices && pnpm libdoc",
    "logo": "node scripts/build-logo.mjs",
    "sitemap": "node scripts/build-sitemap.ts",
    "libdoc": "node scripts/build-libdoc.ts",
    "contributors": "node scripts/build-contributors.ts",
    "project": "node scripts/build-project.ts",
    "releases": "node scripts/build-releases.ts",
    "versions": "node scripts/build-versions.ts",
    "devices": "node scripts/build-devices.ts"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.2",
    "nuxt": "^4.5.2",
    "shiki": "^4.4.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "^13.0.3",
    "happy-dom": "^20.11.2",
    "nuxt-studio": "^1.7.0",
    "playwright-core": "^1.62.1",
    "sanitize-html": "^2.17.6",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
