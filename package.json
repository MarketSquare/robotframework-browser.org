    "better-sqlite3": "^13.0.3",
    "happy-dom": "^21.0.4",
    "nuxt-studio": "^1.8.0",
    "playwright-core": "^1.64.1",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
