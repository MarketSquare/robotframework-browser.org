# pnpm isolates transitive dependencies, so Vite cannot resolve the packages
# @nuxt/content's MDC module asks it to pre-bundle (remark-*, rehype-*,
# unified, parse5 ...) from the project root. They resolve correctly at
# runtime — MDC works — but Vite skips pre-bundling them and warns
# (NUXT_B7002), which also means they get optimised on demand mid-session.
#
# Hoisting exactly that set fixes the resolution rather than silencing the
# warning. Scoped deliberately: `shamefully-hoist=true` is the usual advice
# and would expose every transitive package to accidental import.
public-hoist-pattern[]=remark-*
public-hoist-pattern[]=rehype-*
public-hoist-pattern[]=unist-util-*
public-hoist-pattern[]=micromark*
public-hoist-pattern[]=unified
public-hoist-pattern[]=parse5
public-hoist-pattern[]=debug
public-hoist-pattern[]=extend
public-hoist-pattern[]=@nuxtjs/mdc
